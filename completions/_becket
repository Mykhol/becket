#compdef becket

# Zsh completion for becket — cross-repo worktree CLI

# Discover the workspaces directory by walking up from CWD
__becket_workspaces_dir() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.becket/settings.json" ]]; then
      echo "$dir/.becket/workspaces"
      return
    fi
    dir="${dir:h}"
  done
}

# Discover the settings.json path
__becket_config_file() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/.becket/settings.json" ]]; then
      echo "$dir/.becket/settings.json"
      return
    fi
    dir="${dir:h}"
  done
}

# List workspace IDs
__becket_workspace_ids() {
  local ws_dir
  ws_dir="$(__becket_workspaces_dir)" || return
  [[ -d "$ws_dir" ]] || return
  local -a ids
  for d in "$ws_dir"/*/; do
    [[ -f "$d/.becket.json" ]] && ids+=("${d:h:t}")
  done
  compadd -a ids
}

# List repo names from settings.json
__becket_repo_names() {
  local config
  config="$(__becket_config_file)" || return
  local -a repos
  repos=("${(@f)$(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
for k in d.get('repos', {}):
    print(k)
" "$config" 2>/dev/null)}")
  compadd -a repos
}

_becket() {
  local -a commands
  commands=(
    'init:Initialize .becket/ in current directory'
    'create:Create feature workspace + worktrees'
    'list:List all active feature workspaces'
    'status:Show branch status across repos'
    'teardown:Remove worktrees + workspace'
    'add:Add a repo to existing workspace'
    'setup:Run setup commands for workspace repos'
    'dev:Start dev environment (docker + tmux)'
    'shell:Print workspace directory path (use with shell-init)'
    'shell-init:Output shell wrapper for eval (enables becket shell as cd)'
    'sync:Rebase all repos against their base branch'
    'push:Push all repo branches to origin'
    'pr:Open GitHub PRs for all repos'
    'log:Show commits across all repos since branching'
    'stats:Show local command usage statistics'
    'upgrade:Update config + schemas to latest version'
    'help:Show help'
    'version:Show version'
  )

  if (( CURRENT == 2 )); then
    _deservice -t commands 'becket command' commands
    return
  fi

  local cmd="${words[2]}"
  case "$cmd" in
    create)
      case "${words[CURRENT-1]}" in
        --desc|--base)
          _message 'value'
          ;;
        --repos)
          __becket_repo_names
          ;;
        *)
          _arguments \
            '1:workspace id:' \
            '--desc[Description]:description:' \
            '--repos[Repos to include]:repos:__becket_repo_names' \
            '--base[Override base branch]:branch:' \
            '--setup[Run setup after creating]'
          ;;
      esac
      ;;
    status|setup|dev|shell|sync|push|pr|log)
      if (( CURRENT == 3 )); then
        __becket_workspace_ids
      fi
      ;;
    teardown)
      case "${words[CURRENT-1]}" in
        teardown)
          __becket_workspace_ids
          ;;
        *)
          _arguments \
            '1:workspace id:__becket_workspace_ids' \
            '--delete-branches[Also delete feature branches]'
          ;;
      esac
      ;;
    add)
      if (( CURRENT == 3 )); then
        __becket_workspace_ids
      elif (( CURRENT == 4 )); then
        __becket_repo_names
      fi
      ;;
  esac
}

_becket "$@"
