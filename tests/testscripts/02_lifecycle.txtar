# Core workspace lifecycle: create -> list -> status -> add -> desc -> teardown.
# Ported from tests/scenarios/02_lifecycle.sh + tests/golden/02_lifecycle.txt.
#
# This is the headline path the migration must preserve exactly.
#
# Setup mirrors harness.sh setup_platform: build two repos (each a clone of a
# bare origin with one seeded commit on main) and run `becket init` quietly.
# becket discovers repos alphabetically (admin, service) regardless of build
# order. State is inspected with `exec git` + sanitized file comparisons.

mkdir platform origins

# mk_repo service
exec git init --bare origins/service.git
exec git clone origins/service.git platform/service
cp readme platform/service/README.md
exec git -C platform/service add README.md
exec git -C platform/service commit -m 'init service'
exec git -C platform/service push -u origin main

# mk_repo admin
exec git init --bare origins/admin.git
exec git clone origins/admin.git platform/admin
cp readme platform/admin/README.md
exec git -C platform/admin add README.md
exec git -C platform/admin commit -m 'init admin'
exec git -C platform/admin push -u origin main

cd platform
exec becket init

# ── create a workspace scoped to one repo, with a description ────────────────────
exec becket create proj-42 --desc 'dark mode' --repos service
cp stdout out
cp stderr err
sanitize out err
cmp out $WORK/create-proj42.stdout
cmp err $WORK/create-proj42.stderr

# manifest: proj-42
sanitize $WORK/platform/.becket/workspaces/proj-42/.becket.json
cmp $WORK/platform/.becket/workspaces/proj-42/.becket.json $WORK/manifest-proj42-create.json

# branches: service (deterministic git ordering)
exec git -C $WORK/platform/service branch --format='%(refname:short)'
cp stdout out
sanitize out
cmp out $WORK/branches-service-create.txt

# worktrees: service (-squeeze collapses git's path-dependent column padding)
exec git -C $WORK/platform/service worktree list
cp stdout out
sanitize -squeeze out
cmp out $WORK/worktrees-service-create.txt

# ── list shows the new workspace ────────────────────────────────────────────────
exec becket list
cp stdout out
sanitize out
cmp out $WORK/list-1.stdout

exec becket list --output json
cp stdout out
sanitize out
cmp out $WORK/list-1.json

# ── status (all workspaces) and status for a single workspace ───────────────────
exec becket status
cp stdout out
sanitize out
cmp out $WORK/status-all.stdout

exec becket status proj-42
cp stdout out
sanitize out
cmp out $WORK/status-one.stdout

exec becket status proj-42 --output json
cp stdout out
sanitize out
cmp out $WORK/status-one.json

# ── add a second repo to the workspace (reuses the feature branch) ──────────────
exec becket add proj-42 admin
cp stdout out
cp stderr err
sanitize out err
cmp out $WORK/add-admin.stdout
cmp err $WORK/add-admin.stderr

sanitize $WORK/platform/.becket/workspaces/proj-42/.becket.json
cmp $WORK/platform/.becket/workspaces/proj-42/.becket.json $WORK/manifest-proj42-add.json

exec git -C $WORK/platform/admin branch --format='%(refname:short)'
cp stdout out
sanitize out
cmp out $WORK/branches-admin-add.txt

# workspaces tree shape (the result of create+add: docs/, AGENTS.md, schemas)
exists $WORK/platform/.becket/workspaces/proj-42/.becket.json
exists $WORK/platform/.becket/workspaces/proj-42/AGENTS.md
exists $WORK/platform/.becket/workspaces/proj-42/docs
exists $WORK/platform/.becket/workspaces/proj-42/service
exists $WORK/platform/.becket/workspaces/proj-42/admin
exists $WORK/platform/.becket/workspaces/proj-42/workspace.schema.json

# ── change the description after the fact ───────────────────────────────────────
exec becket desc proj-42 'real-time dark mode'
cp stdout out
sanitize out
cmp out $WORK/desc.stdout

sanitize $WORK/platform/.becket/workspaces/proj-42/.becket.json
cmp $WORK/platform/.becket/workspaces/proj-42/.becket.json $WORK/manifest-proj42-desc.json

# ── creating with no --repos selects all repos (non-TTY default) ────────────────
exec becket create dash-9
cp stdout out
cp stderr err
sanitize out err
cmp out $WORK/create-dash9.stdout
cmp err $WORK/create-dash9.stderr

sanitize $WORK/platform/.becket/workspaces/dash-9/.becket.json
cmp $WORK/platform/.becket/workspaces/dash-9/.becket.json $WORK/manifest-dash9.json

exec becket list
cp stdout out
sanitize out
cmp out $WORK/list-2.stdout

# ── teardown removes worktrees and (with --delete-branches) the branches ────────
exec becket teardown proj-42 --delete-branches
cp stdout out
sanitize out
cmp out $WORK/teardown.stdout

exec git -C $WORK/platform/service branch --format='%(refname:short)'
cp stdout out
sanitize out
cmp out $WORK/branches-service-teardown.txt

exec git -C $WORK/platform/service worktree list
cp stdout out
sanitize -squeeze out
cmp out $WORK/worktrees-service-teardown.txt

# proj-42 workspace dir is gone; dash-9 remains
! exists $WORK/platform/.becket/workspaces/proj-42
exists $WORK/platform/.becket/workspaces/dash-9

exec becket list
cp stdout out
sanitize out
cmp out $WORK/list-3.stdout

