{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "becket-workspace",
  "title": "Becket Workspace Manifest",
  "description": "Manifest for a becket workspace.",
  "type": "object",
  "required": ["id", "created", "repos"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "description": "Workspace identifier."
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Creation date (YYYY-MM-DD)."
    },
    "description": {
      "type": "string",
      "description": "Optional workspace description."
    },
    "stackParent": {
      "type": "string",
      "description": "Workspace ID this workspace is stacked on. When set, this workspace's branches are based on the parent's branches (not main), and 'becket restack' rebases this workspace's branches onto the parent's current branch tips."
    },
    "status": {
      "type": "object",
      "description": "Current workspace status, settable by humans or agents.",
      "properties": {
        "text": {
          "type": "string",
          "description": "Free-text status message (e.g. 'implementing API endpoints', 'blocked on auth review')."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of last status update."
        },
        "updatedBy": {
          "type": "string",
          "description": "Who set this status (e.g. 'claude', 'michael', 'agent-1')."
        }
      },
      "additionalProperties": false
    },
    "repos": {
      "type": "object",
      "description": "Map of repository names to their workspace configuration.",
      "additionalProperties": {
        "type": "object",
        "required": ["branch", "base"],
        "properties": {
          "branch": {
            "type": "string",
            "description": "Feature branch name."
          },
          "base": {
            "type": "string",
            "description": "Base branch this workspace was created from."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
